// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  type        String   // "INCOME" or "EXPENSE"
  category    String
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Investment {
  id               String   @id @default(uuid())
  name             String
  category         String   // "Saham", "Reksadana", "Kripto", "Emas", dll
  investedAmount   Float
  currentValue     Float
  dividends        Float?   @default(0)
  quantity         Float?   @default(1)
  unitType         String?  @default("Unit")
  averagePrice     Float?   @default(0)
  lastPricePerUnit Float?   @default(0)
  date             DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchases        InvestmentPurchase[]
  dividendRecords  InvestmentDividend[]
}

model InvestmentDividend {
  id               String   @id @default(uuid())
  investmentId     String
  investment       Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  amount           Float
  date             DateTime @default(now())
  createdAt        DateTime @default(now())
}

model InvestmentPurchase {
  id               String   @id @default(uuid())
  investmentId     String
  investment       Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  quantity         Float
  pricePerUnit     Float
  totalAmount      Float
  date             DateTime @default(now())
  createdAt        DateTime @default(now())
}

model MonthlyReport {
  id               String   @id @default(uuid())
  month            String   // e.g., "April 2026"
  totalAssets      Float
  totalIncome      Float
  totalExpense     Float
  investmentValue  Float
  aiAnalysis       String?
  createdAt        DateTime @default(now())
}
